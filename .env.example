# Public Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Configure as secrets; never use NEXT_PUBLIC_ for these keys.
SUPABASE_SERVICE_ROLE_KEY=
WEBPAY_API_KEY_SECRET=

# Start in integration (test) mode. Set the official Transbank test API key above.
# Real commerce code, reserved for later production activation: 597053098347.
WEBPAY_ENVIRONMENT=integration
WEBPAY_COMMERCE_CODE=597055555532
# Explicit opt-in requested by the owner to test on the published storefront.
WEBPAY_ALLOW_TEST_ON_PRODUCTION=true
SITE_URL=https://www.dmaestros.cl
