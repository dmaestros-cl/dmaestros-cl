# Public Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Configure as secrets; never use NEXT_PUBLIC_ for these keys.
SUPABASE_SERVICE_ROLE_KEY=
WEBPAY_API_KEY_SECRET=

# Public checkout activates only with complete production credentials.
# Keep WEBPAY_API_KEY_SECRET empty until Transbank supplies the private key.
WEBPAY_ENVIRONMENT=production
WEBPAY_COMMERCE_CODE=597053098347
# Historical integration callbacks only; never enables public sandbox purchases.
WEBPAY_ALLOW_TEST_ON_PRODUCTION=false
SITE_URL=https://www.dmaestros.cl

# Transactional order confirmations. Server-only; use a verified sender domain.
RESEND_API_KEY=
EMAIL_FROM=DMaestros <ventas@dmaestros.cl>
ADMIN_NOTIFICATION_EMAIL=
